{
	"compilerOptions": {
		"module": "node16",
		"target": "es2022",
		"lib": [
			"ES2022"
		],
		"types": ["node"],
		"sourceMap": true,
		"rootDir": "src",
		"paths": {
			"@core/*": ["./src/core/*"],
			"@infraestructure/*": ["./src/infraestructure/*"],
			"@vscode/*": ["./src/vscode/*"],
			"@web/*": ["./src/web/*"],
   		}	
	}
}
