{
	"compilerOptions": {
		"module": "Node16",
		"target": "ES2022",
		"lib": [
			"ES2022"
		],
		"sourceMap": true,
		"rootDir": "src",
		"paths": {
			"@assets/*": ["./src/assets/*"],
			"@entities/*": ["./src/entities/*"],
			"@interfaces/*": ["./src/interfaces/*"],
			"@model/*": ["./src/model/*"],
			"@providers/*": ["./src/providers/*"],
			"@styles/*": ["./src/styles/*"],
			"@views/*": ["./src/views/*"],

   		}	
	}
}
