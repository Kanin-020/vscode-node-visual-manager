{
  "name": "node-visual-manager",
  "displayName": "Node Visual Manager",
  "version": "1.0.8",
  "publisher": "kanin-020",
  "description": "Node Version Manager adaptation for VSCode.",
  "author": {
    "name": "Jesus Miguel Alvarez Vazquez"
  },
  "categories": [
    "Visualization"
  ],
  "icon": "resources/icon.png",
  "pricing": "Free",
  "activationEvents": [],
  "engines": {
    "vscode": "^1.86.0"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "node-visual-manager-sidebar-view",
          "title": "Node Visual Manager",
          "icon": "/dist/webview/assets/images/nvm.svg"
        }
      ]
    },
    "views": {
      "node-visual-manager-sidebar-view": [
        {
          "type": "webview",
          "id": "node-visual-manager-sidebar",
          "name": "Node Visual Manager"
        },
        {
          "type": "webview",
          "id": "node-visual-manager-sidebar-available",
          "name": "Available Node Versions"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@babel/core": "^7.24.7",
    "@babel/preset-env": "^7.24.7",
    "@babel/preset-react": "^7.24.7",
    "@babel/preset-typescript": "^7.24.7",
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@types/vscode": "^1.86.0",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.9",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^6.0.0",
    "eslint": "^8.56.0",
    "html-minimizer-webpack-plugin": "^5.0.0",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.10",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.2",
    "webpack": "^5.92.1",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.35",
    "node-fetch": "^3.3.2",
    "process": "^0.11.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "window-or-global": "^1.0.1"
  },
  "license": "SEE LICENSE IN LICENSE.txt",
  "bugs": {
    "url": "https://github.com/Kanin-020/Node-Visual-Manager-Issues",
    "email": "jesus.alvarez.vazquez@hotmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kanin-020/Node-Visual-Manager-Issues"
  },
  "homepage": "https://github.com/Kanin-020/Node-Visual-Manager/blob/main/README.md"
}
