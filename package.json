{
    "name": "node-visual-manager",
    "displayName": "NVM - Node Visual Manager",
    "version": "1.4.0",
    "publisher": "kanin-020",
    "description": "A VS Code extension to manage Node.js versions via NVM directly in the editor.",
    "author": {
        "name": "Jesús Álvarez"
    },
    "categories": [
        "Visualization"
    ],
    "icon": "resources/icon.webp",
    "pricing": "Free",
    "activationEvents": [
        "onStartupFinished",
        "workspaceContains:.nvmrc"
    ],
    "engines": {
        "vscode": "^1.96.0"
    },
    "keywords": [
        "nvm",
        "NVM",
        "vscode-nvm",
        "vsc-nvm",
        "node",
        "nodejs",
        "manager",
        "admin",
        "version manager",
        "version",
        "node version",
        "fnm",
        "FNM",
        "npm",
        "NPM",
        "npx",
        "NPX",
        "web",
        "WEB",
        "javascript",
        "JavaScript",
        "switch versions",
        "change versions"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "node-visual-manager-sidebar-view",
                    "title": "Node Visual Manager",
                    "icon": "/dist/webview/assets/images/nvm.svg"
                }
            ]
        },
        "views": {
            "node-visual-manager-sidebar-view": [
                {
                    "icon": "",
                    "type": "webview",
                    "id": "node-visual-manager-sidebar-current",
                    "name": "Installed Node Versions"
                },
                {
                    "icon": "",
                    "type": "webview",
                    "id": "node-visual-manager-sidebar-available",
                    "name": "Available Node Versions"
                }
            ]
        }
    },
    "scripts": {
        "compile": "webpack",
        "watch": "webpack --watch",
        "compile-tests": "tsc -p tsconfig.test.json",
        "watch-tests": "tsc -p tsconfig.test.json -w",
        "lint": "eslint src --ext ts,tsx",
        "lint:fix": "eslint src --ext ts,tsx --fix",
        "format": "prettier --write \"src/**/*.ts\" \"src/**/*.tsx\"",
        "format:check": "prettier --check \"src/**/*.ts\" \"src/**/*.tsx\"",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "test": "mocha out/tests/**/*.test.js",
        "clean": "rimraf --glob dist out *.vsix",
        "compile:production": "npm run clean && webpack --mode production --devtool hidden-source-map",
        "package": "npm run compile:production && vsce package",
        "publish": "npm run compile:production && vsce publish"
    },
    "dependencies": {},
    "devDependencies": {
        "@vscode/codicons": "^0.0.45",
        "process": "^0.11.10",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "window-or-global": "^1.0.1",
        "@babel/core": "^7.24.7",
        "@babel/preset-env": "^7.24.7",
        "@babel/preset-react": "^7.24.7",
        "@babel/preset-typescript": "^7.24.7",
        "@types/mocha": "^10.0.6",
        "@types/node": "^18.19.130",
        "@types/vscode": "^1.86.0",
        "@typescript-eslint/eslint-plugin": "^8.69.0",
        "@typescript-eslint/parser": "^8.69.0",
        "@vscode/test-cli": "^0.0.4",
        "@vscode/test-electron": "^2.3.9",
        "@vscode/vsce": "^3.9.2",
        "babel-loader": "^9.1.3",
        "copy-webpack-plugin": "^12.0.2",
        "css-loader": "^7.1.2",
        "css-minimizer-webpack-plugin": "^6.0.0",
        "eslint": "^8.56.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "html-minimizer-webpack-plugin": "^5.0.0",
        "prettier": "^3.9.6",
        "rimraf": "^5.0.10",
        "style-loader": "^4.0.0",
        "terser-webpack-plugin": "^5.3.10",
        "ts-loader": "^9.5.1",
        "typescript": "^5.5.2",
        "webpack": "^5.92.1",
        "webpack-cli": "^5.1.4"
    },
    "license": "Apache-2.0",
    "bugs": {
        "url": "https://github.com/Kanin-020/vscode-node-visual-manager"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Kanin-020/vscode-node-visual-manager.git"
    },
    "homepage": "https://github.com/Kanin-020/vscode-node-visual-manager/blob/main/README.md"
}